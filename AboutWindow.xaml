<Window x:Class="PZServerManager.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="關於此應用" Width="690" Height="650" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Icon="Assets/pz-server-manager.ico"
 Background="#101619" Foreground="#EAF0F2" FontFamily="{DynamicResource AppUiFontFamily}">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="112"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border Width="96" Height="96" Background="#182026" BorderBrush="#354650"
    BorderThickness="1" CornerRadius="12" Padding="8" HorizontalAlignment="Left">
    <Image Source="Assets/pz-server-manager-icon.png" Stretch="Uniform"/>
   </Border>
   <StackPanel Grid.Column="1" Margin="18,4,0,0">
    <TextBlock Text="PZ Build 42 伺服器管理器" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock x:Name="AboutVersionText" Text="版本" Foreground="#E1A84B"
     FontSize="16" FontWeight="Bold" Margin="0,7,0,0"/>
    <TextBlock Text="Windows Server 2022 Desktop Experience x64" Foreground="#AFC0C8"
     FontSize="13" Margin="0,5,0,0"/>
   </StackPanel>
  </Grid>

  <Border Grid.Row="1" Background="#182026" BorderBrush="#354650" BorderThickness="1"
   CornerRadius="8" Padding="16" Margin="0,20,0,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <TextBlock Text="創建者" Foreground="#AFC0C8" FontWeight="SemiBold"/>
    <TextBlock x:Name="CreatorText" Grid.Column="1" Text="MapleLeaf" FontWeight="Bold" Foreground="#E1A84B"/>
   </Grid>
  </Border>

  <Border Grid.Row="2" Background="#182026" BorderBrush="#354650" BorderThickness="1"
   CornerRadius="8" Padding="18">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="免責聲明" FontSize="18" FontWeight="Bold" Foreground="#E1A84B"
      Margin="0,0,0,10"/>
     <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" LineHeight="22" Foreground="#D8E3E7"><Run
      Text="本程式是由 MapleLeaf 製作的非官方獨立管理工具，並非 The Indie Stone、Project Zomboid、Valve 或 Steam 的官方產品，也未獲其背書或保證。"/><LineBreak/><LineBreak/><Run
      Text="Project Zomboid、Steam、SteamCMD 及其他商標、遊戲內容與服務之權利均屬各自權利人所有。"/><LineBreak/><LineBreak/><Run
      Text="伺服器版本、設定格式、模組、Steam Workshop 項目與第三方網路服務可能隨時變更。使用者應在套用設定、更新伺服器、安裝模組或重建世界前自行建立可還原的完整備份。管理器產生的設定備份不能取代 VM 快照或離線備份。"/><LineBreak/><LineBreak/><Run
      Text="本程式按現況提供，不保證適合任何特定用途，亦不保證完全無錯誤、不中斷或不造成設定衝突。因使用本程式、網路或 CDN 遭劫持、第三方內容被竄改、遊戲更新、模組錯誤或操作不當所產生的資料遺失、服務中斷、安全問題或其他損失，使用者應自行承擔風險。"/>
     </TextBlock>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Grid Grid.Row="3" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="© 2026 MapleLeaf" Foreground="#71808A" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="關閉" Width="110" IsDefault="True" Click="Close_Click"
    Background="#8A641F"/>
  </Grid>
 </Grid>
</Window>
