<Window x:Class="PZServerManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PZ Build 42 伺服器管理器" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Icon="Assets/pz-server-manager.ico"
 Background="#101619" Foreground="#EAF0F2" FontFamily="{DynamicResource AppUiFontFamily}">
 <Grid>
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#182026" BorderBrush="#354650" BorderThickness="0,0,0,1">
   <Grid Margin="20,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="Assets/pz-server-manager-icon.png" Width="46" Height="46" Stretch="Uniform"
      Margin="0,0,13,0" SnapsToDevicePixels="True"/>
     <StackPanel VerticalAlignment="Center">
       <TextBlock Text="PROJECT ZOMBOID" Foreground="#E1A84B" FontWeight="Bold" FontSize="12"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="BUILD 42 伺服器管理器" FontWeight="SemiBold" FontSize="23"/>
       <Border Background="#8A641F" CornerRadius="3" Padding="7,2" Margin="10,5,0,3">
        <TextBlock x:Name="HeaderVersionText" Text="v2.0.0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
       </Border>
      </StackPanel>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="關於此應用" Click="About_Click" Padding="12,6" Margin="0,0,20,0"
      Background="#263841" FontSize="13"/>
     <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#71808A" Margin="0,0,8,0"/>
     <TextBlock x:Name="StatusText" Text="已停止" FontSize="16" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Border>
   <TabControl x:Name="MainTabs" Grid.Row="1" Margin="8" Background="#182026" BorderBrush="#354650" Foreground="White"
    SelectionChanged="MainTabs_SelectionChanged"
    ItemContainerStyle="{StaticResource PrimaryTabItem}">
   <TabItem Header=" 儀表板 ">
     <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel>
      <Button x:Name="InstallButton" Content="安裝 / 更新伺服器" Click="Install_Click"/>
      <Button Content="寫入基礎設定" Click="SaveConfig_Click"/>
      <Button x:Name="StartButton" Content="▶ 啟動伺服器" Background="#297052" Click="Start_Click"/>
      <Button x:Name="SaveWorldButton" Content="💾 立即存檔" Click="SaveWorld_Click" IsEnabled="False"/>
      <Button x:Name="StopButton" Content="■ 存檔並關服" Background="#8A3D38" Click="Stop_Click" IsEnabled="False"/>
      <Button Content="立即備份" Click="Backup_Click"/>
      <Button Content="開啟伺服器資料夾" Click="OpenFolder_Click"/>
     <Button Content="檢查／還原設定備份" Click="RestoreConfigBackup_Click"/>
     <Border Background="#11181C" BorderBrush="#354650" BorderThickness="1" CornerRadius="5"
      Padding="5,1" Margin="8,4,4,4">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Label Content="介面語言"/>
       <ComboBox x:Name="UiLanguageCombo" Width="145" Margin="4"
        DisplayMemberPath="DisplayName" SelectedValuePath="Code"
        SelectionChanged="UiLanguageCombo_SelectionChanged"/>
       <Button Content="重新載入翻譯" Padding="9,5" Click="ReloadLanguages_Click"/>
       <Button Content="開啟翻譯資料夾" Padding="9,5" Click="OpenLanguagesFolder_Click"/>
      </StackPanel>
     </Border>
     </WrapPanel>
      <Border x:Name="CliHealthBanner" Grid.Row="1" Visibility="Collapsed" Background="#482724"
       BorderBrush="#D9695F" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,6">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CliHealthText" Text="PZ CLI 回應異常" Foreground="#FFD5D0"
         FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
         <Button Content="立即測試回應" Click="TestCliResponse_Click"/>
         <Button x:Name="ForceTerminateFrozenServerButton" Content="強制終止卡死程序" Background="#8A3D38"
          Click="ForceTerminateFrozenServer_Click" IsEnabled="False"/>
        </StackPanel>
       </Grid>
      </Border>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <GroupBox Header="即時主控台">
       <TextBox x:Name="ConsoleBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
        TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </GroupBox>
      <GroupBox Grid.Column="1" Header="在線玩家">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="OnlinePlayerSummaryText" Text="伺服器未啟動" Foreground="#AFC0C8" Margin="5"/>
        <ListBox x:Name="OnlinePlayersListBox" Grid.Row="1" Background="#11171B" Foreground="#EAF0F2" Margin="4"/>
        <Button Grid.Row="2" Content="立即重新整理" Click="RefreshPlayers_Click"/>
       </Grid>
      </GroupBox>
     </Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="CommandBox" ToolTip="輸入伺服器指令，例如 players、servermsg 訊息" KeyDown="CommandBox_KeyDown"/>
      <Button Grid.Column="1" Content="送出指令" Click="SendCommand_Click"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem x:Name="BasicSettingsTab" Header=" 基礎設定 ">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="15">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <GroupBox Header="安裝位置"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <Label Content="SteamCMD"/><TextBox x:Name="SteamCmdPathBox" Grid.Column="1"/>
       <Label Grid.Row="1" Content="伺服器目錄"/><TextBox x:Name="InstallPathBox" Grid.Row="1" Grid.Column="1"/>
       <Label Grid.Row="2" Content="資料目錄"/><TextBox x:Name="DataPathBox" Grid.Row="2" Grid.Column="1"/>
       <Label Grid.Row="3" Content="設定檔編碼"/>
       <ComboBox x:Name="ConfigEncodingCombo" Grid.Row="3" Grid.Column="1" Margin="4"
        SelectionChanged="ConfigEncodingCombo_SelectionChanged">
        <ComboBoxItem Tag="Auto">自動：BOM → UTF-8 → Big5（預設）</ComboBoxItem>
        <ComboBoxItem Tag="Utf8">UTF-8（無 BOM）</ComboBoxItem>
        <ComboBoxItem Tag="Utf8Bom">UTF-8（有 BOM）</ComboBoxItem>
        <ComboBoxItem Tag="Big5">Big5／CP950</ComboBoxItem>
        <ComboBoxItem Tag="RepairUtf8FromBig5">修復：UTF-8 曾被 Big5 誤讀後存檔</ComboBoxItem>
        <ComboBoxItem Tag="Utf16LE">UTF-16 LE</ComboBoxItem>
        <ComboBoxItem Tag="Utf16BE">UTF-16 BE</ComboBoxItem>
       </ComboBox>
       <Label Grid.Row="4" Content="Manager 設定位置"/>
       <ComboBox x:Name="SettingsStorageCombo" Grid.Row="4" Grid.Column="1" Margin="4">
        <ComboBoxItem Tag="ExeDirectory">與 EXE 同一資料夾（預設）</ComboBoxItem>
        <ComboBoxItem Tag="LocalAppData">目前 Windows 使用者 AppData</ComboBoxItem>
       </ComboBox>
       <Label Grid.Row="5" Content="介面字型"/>
       <ComboBox x:Name="UiFontCombo" Grid.Row="5" Grid.Column="1" Margin="4"
        SelectionChanged="UiFontCombo_SelectionChanged"
        ToolTip="選取後立即套用；只影響管理器介面">
        <ComboBoxItem Tag="NotoSansTC">Noto Sans TC－清晰現代（預設）</ComboBoxItem>
        <ComboBoxItem Tag="NotoSerifTC">Noto Serif TC－正式襯線</ComboBoxItem>
        <ComboBoxItem Tag="LXGWWenKaiTC">霞鶩文楷 TC－自然手寫</ComboBoxItem>
        <ComboBoxItem Tag="MicrosoftJhengHeiUI">微軟正黑體 UI－系統字型</ComboBoxItem>
       </ComboBox>
      </Grid></GroupBox>
      <GroupBox Header="伺服器資訊"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <Label Content="設定檔名稱"/><TextBox x:Name="ServerNameBox" Grid.Column="1"/>
       <Label Grid.Row="1" Content="公開名稱（不預填）"/><TextBox x:Name="PublicNameBox" Grid.Row="1" Grid.Column="1"/>
       <Label Grid.Row="2" Content="說明（不預填）"/><TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1"/>
       <Label Grid.Row="3" Content="加入密碼（不預填）"/><PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1"/>
       <Label Grid.Row="4" Content="管理員密碼"/><PasswordBox x:Name="AdminPasswordBox" Grid.Row="4" Grid.Column="1"/>
      </Grid></GroupBox>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <GroupBox Header="連線與效能"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <Label Content="主要連接埠（預設 16261；0–65535）"/><TextBox x:Name="PortBox" Grid.Column="1"/>
       <Label Grid.Row="1" Content="直接連線埠（預設 16262；0–65535）"/><TextBox x:Name="UdpPortBox" Grid.Row="1" Grid.Column="1"/>
       <Label Grid.Row="2" Content="最大玩家數（預設 32；1–100）"/><TextBox x:Name="PlayersBox" Grid.Row="2" Grid.Column="1"/>
       <Label Grid.Row="3" Content="記憶體 GB（管理器；2–128）"/><TextBox x:Name="MemoryBox" Grid.Row="3" Grid.Column="1"/>
       <Label Grid.Row="4" Content="Steam Beta 分支"/><TextBox x:Name="BetaBox" Grid.Row="4" Grid.Column="1" ToolTip="B42 Stable 留空；測試版使用 unstable"/>
      </Grid></GroupBox>
      <GroupBox Header="存取方式"><StackPanel>
       <CheckBox x:Name="PublicCheck" Content="列在公開伺服器清單"/>
       <CheckBox x:Name="OpenCheck" Content="允許新玩家直接加入"/>
        <CheckBox x:Name="PauseCheck" Content="無玩家時暫停世界（Build 42 斷線／快速重連環境不建議）"
         ToolTip="PauseEmpty=true 曾在 Build 42 斷線／快速重連情境伴隨主迴圈卡死；管理器只提示，不會擅自改寫官方預設。"/>
      </StackPanel></GroupBox>
     </StackPanel>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ExistingServersTab" Header=" 設定檔管理 ">
     <Grid Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel>
       <Button Content="重新掃描設定檔" Click="ScanServers_Click"/>
       <Button Content="新設定檔" Background="#297052" Click="CreateProfile_Click"/>
       <Button Content="複製並重新命名" Click="CopyProfile_Click"/>
       <Button Content="載入選取伺服器" Background="#8A641F" Click="UseSelectedServer_Click"/>
      <Button Content="恢復選取格預設" Click="ResetSelectedDefault_Click"/>
      <Button Content="全部返回預設" Background="#7A433A" Click="ResetAllDefaults_Click"/>
      <Button Content="儲存待套用值" Background="#297052" Click="SaveInspectedValues_Click"/>
      <TextBlock x:Name="ScanSummaryText" Text="尚未掃描" Margin="12,0" VerticalAlignment="Center" Foreground="#AFC0C8"/>
      </WrapPanel>
      <Grid Grid.Row="1" Margin="0,4,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SettingSearchBox" ToolTip="搜尋設定鍵、分類、目前值或說明"
        TextChanged="SettingSearchBox_TextChanged"/>
       <ComboBox x:Name="SettingFilterCombo" Grid.Column="1" Margin="4" SelectionChanged="SettingFilterCombo_SelectionChanged">
        <ComboBoxItem Tag="All">全部設定</ComboBoxItem><ComboBoxItem Tag="Changed">只顯示已修改</ComboBoxItem>
        <ComboBoxItem Tag="Pending">只顯示待套用</ComboBoxItem><ComboBoxItem Tag="Unknown">只顯示未註明</ComboBoxItem>
        <ComboBoxItem Tag="Invalid">只顯示無效值</ComboBoxItem>
       </ComboBox>
       <TextBlock x:Name="SettingsFilterSummaryText" Grid.Column="2" VerticalAlignment="Center" Margin="10,0"
        Foreground="#AFC0C8" Text="顯示全部"/>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <GroupBox Header="找到的設定檔"><ListBox x:Name="ServerListBox" DisplayMemberPath="DisplayName"
       Background="#11171B" Foreground="White" BorderThickness="0" SelectionChanged="ServerListBox_SelectionChanged"/></GroupBox>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#354650"/>
      <GroupBox Grid.Column="2" Header="目前值與 Build 42 預設">
       <DataGrid x:Name="SettingsGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionUnit="FullRow"
        Background="#11171B" Foreground="#EAF0F2" RowBackground="#182026" AlternatingRowBackground="#222D34"
        GridLinesVisibility="Horizontal" BorderThickness="0" HeadersVisibility="Column">
        <DataGrid.Columns>
         <DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="110" IsReadOnly="True"/>
         <DataGridTextColumn Header="設定鍵" Binding="{Binding Key}" Width="220" IsReadOnly="True"/>
         <DataGridTextColumn Header="目前值" Binding="{Binding CurrentValue}" Width="*"/>
         <DataGridTextColumn Header="預設值" Binding="{Binding DefaultValue}" Width="130" IsReadOnly="True"/>
         <DataGridTextColumn Header="允許範圍／選項" Binding="{Binding AllowedRange}" Width="180" IsReadOnly="True"/>
         <DataGridTextColumn Header="官方註記／說明" Binding="{Binding Notes}" Width="2*" IsReadOnly="True"/>
         <DataGridTextColumn Header="規格來源" Binding="{Binding MetadataSource}" Width="150" IsReadOnly="True"/>
         <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
        </DataGrid.Columns>
       </DataGrid>
      </GroupBox>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem x:Name="FullSettingsTab" Header=" 完整設定 ">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="FullSettingsPages" Background="#182026" BorderBrush="#354650"
       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
       ItemContainerStyle="{StaticResource SettingsRailTabItem}" TabStripPlacement="Left">
       <TabItem x:Name="ServerPermissionsPage" Header="伺服器與權限"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="14">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel>
        <GroupBox Header="遊戲規則"><StackPanel>
         <CheckBox x:Name="PvpCheck" Content="允許玩家互相傷害（PVP）"/>
         <CheckBox x:Name="SafetyCheck" Content="啟用玩家 PVP 安全模式切換"/>
         <CheckBox x:Name="SleepAllowedCheck" Content="允許玩家睡覺"/>
         <CheckBox x:Name="SleepNeededCheck" Content="玩家會疲勞且必須睡覺"/>
         <CheckBox x:Name="VoiceCheck" Content="啟用遊戲內語音"/>
         <CheckBox x:Name="SafehouseCheck" Content="允許玩家建立安全屋"/>
        </StackPanel></GroupBox>
         <GroupBox Header="訊息"><StackPanel><Label Content="玩家加入歡迎訊息（不預填；用 &lt;LINE&gt; 換行）"/>
         <TextBox x:Name="WelcomeBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></GroupBox>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <GroupBox Header="效能與存檔"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Label Content="Ping 上限（預設 400；100–2147483647）"/><TextBox x:Name="PingLimitBox" Grid.Column="1"/>
         <Label Grid.Row="1" Content="存檔分鐘（預設 0；0–2147483647）"/><TextBox x:Name="SaveMinutesBox" Grid.Row="1" Grid.Column="1"/>
         <Label Grid.Row="2" Content="備份保留數（預設 5；1–300）"/><TextBox x:Name="BuiltInBackupsBox" Grid.Row="2" Grid.Column="1"/>
         <Label Grid.Row="3" Content="物資重生小時（預設 0；0=停用）"/><TextBox x:Name="LootRespawnHoursBox" Grid.Row="3" Grid.Column="1"/>
        </Grid></GroupBox>
        <GroupBox Header="RCON 遠端管理"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Label Content="RCON TCP 埠（預設 27015；0–65535）"/><TextBox x:Name="RconPortBox" Grid.Column="1"/>
         <Label Grid.Row="1" Content="RCON 密碼"/><PasswordBox x:Name="RconPasswordBox" Grid.Row="1" Grid.Column="1"/>
        </Grid></GroupBox>
       </StackPanel>
      </Grid></ScrollViewer></TabItem>
       <TabItem x:Name="WorldItemsPage" Header="世界與物資"><Grid Margin="14">
       <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <GroupBox Header="時間與生存"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Label Content="一天長度"/><ComboBox x:Name="DayLengthCombo" Grid.Column="1" Margin="4">
          <ComboBoxItem Tag="1">15 分鐘</ComboBoxItem><ComboBoxItem Tag="2">30 分鐘</ComboBoxItem><ComboBoxItem Tag="3">1 小時</ComboBoxItem><ComboBoxItem Tag="4">2 小時</ComboBoxItem><ComboBoxItem Tag="5">3 小時</ComboBoxItem><ComboBoxItem Tag="6">4 小時</ComboBoxItem>
         </ComboBox>
         <Label Grid.Row="1" Content="停水天數（預設 14；-1=永不）"/><TextBox x:Name="WaterDaysBox" Grid.Row="1" Grid.Column="1"/>
         <Label Grid.Row="2" Content="停電天數（預設 14；-1=永不）"/><TextBox x:Name="ElectricDaysBox" Grid.Row="2" Grid.Column="1"/>
         <Label Grid.Row="3" Content="經驗倍率（預設 1.0；0–1000）"/><TextBox x:Name="XpBox" Grid.Row="3" Grid.Column="1"/>
        </Grid></GroupBox>
        <GroupBox Header="角色建立與出生物品">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
           <Label Content="創角額外點數（預設 0；-100–100）"/><TextBox x:Name="CharacterFreePointsBox" Grid.Column="1"/>
           <Label Grid.Row="1" Content="出生物品 ID（預設空白）"/><TextBox x:Name="SpawnItemsBox" Grid.Row="1" Grid.Column="1" ToolTip="只驗證、不自動替換。Build 42 範例：Base.BaseballBat,Base.WaterBottle,Base.Chocolate"/>
          </Grid>
          <CheckBox x:Name="StarterKitCheck" Content="啟用遊戲內建 StarterKit（額外背包、球棒等；通常不建議與自訂出生物品同時啟用）"/>
          <Button Content="明確套用 B42 範例：球棒＋水＋巧克力" HorizontalAlignment="Left" Click="ApplyStarterLoadout_Click"/>
          <TextBlock x:Name="SpawnItemsStatusText" Text="管理器不會自動增加、刪除或替換物品 ID。" Foreground="#AFC0C8" TextWrapping="Wrap" Margin="8"/>
          <TextBlock Text="注意：Build 42 原生 SpawnItems 套用於每次建立新角色，包含死亡後重建；首次創角與復活無法分開設定。"
                     Foreground="#E1A84B" TextWrapping="Wrap" Margin="8"/>
         </StackPanel>
        </GroupBox>
       </StackPanel></ScrollViewer>
       <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <GroupBox Header="物資倍率（預設 0.6；允許 0.00–4.00）"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Label Content="食物"/><TextBox x:Name="FoodLootBox" Grid.Column="1"/>
         <Label Grid.Row="1" Content="近戰／工具"/><TextBox x:Name="WeaponLootBox" Grid.Row="1" Grid.Column="1"/>
         <Label Grid.Row="2" Content="彈藥"/><TextBox x:Name="AmmoLootBox" Grid.Row="2" Grid.Column="1"/>
         <Label Grid.Row="3" Content="醫療"/><TextBox x:Name="MedicalLootBox" Grid.Row="3" Grid.Column="1"/>
         <Label Grid.Row="4" Content="其他"/><TextBox x:Name="OtherLootBox" Grid.Row="4" Grid.Column="1"/>
        </Grid></GroupBox>
        <TextBlock x:Name="LootSchemaHint" Text="B42 使用 0.00–4.00 小數倍率；數值越高，物資越多。" Foreground="#AFC0C8" TextWrapping="Wrap" Margin="10"/>
       </StackPanel></ScrollViewer>
      </Grid></TabItem>
       <TabItem x:Name="WorldDetailsPage" Header="世界詳細">
       <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#121B20" BorderBrush="#354650" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
         <DockPanel>
          <Button DockPanel.Dock="Right" Tag="World" Content="恢復選取列預設" Click="ResetFeaturedDefault_Click"/>
          <StackPanel><TextBlock Text="世界詳細設定" FontSize="20" FontWeight="SemiBold"/>
           <TextBlock x:Name="WorldDetailsSummaryText" Text="尚未讀取設定檔" Foreground="#AFC0C8" Margin="0,5,0,0"/>
          </StackPanel>
         </DockPanel>
        </Border>
        <DataGrid x:Name="WorldDetailsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
         CanUserDeleteRows="False" SelectionUnit="FullRow" Background="#11171B" Foreground="#EAF0F2"
         RowBackground="#182026" AlternatingRowBackground="#222D34" HeadersVisibility="Column">
         <DataGrid.Columns>
          <DataGridTextColumn Header="設定名稱" Binding="{Binding DisplayName}" Width="190" IsReadOnly="True"/>
          <DataGridTextColumn Header="原始設定鍵" Binding="{Binding Key}" Width="190" IsReadOnly="True"/>
          <DataGridTextColumn Header="目前值" Binding="{Binding CurrentValue}" Width="115"/>
          <DataGridTextColumn Header="預設值" Binding="{Binding DefaultValue}" Width="105" IsReadOnly="True"/>
          <DataGridTextColumn Header="允許範圍／選項" Binding="{Binding LocalizedAllowedRange}" Width="1.5*" IsReadOnly="True"/>
          <DataGridTextColumn Header="繁中說明" Binding="{Binding LocalizedNotes}" Width="2.5*" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
       </Grid>
      </TabItem>
