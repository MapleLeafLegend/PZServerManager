       <TabItem x:Name="ModsPage" Header="模組">
        <Grid Margin="2">
         <TabControl Background="#182026" BorderBrush="#354650"
          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
          ItemContainerStyle="{StaticResource DenseSettingsTabItem}">
          <TabItem Header="Workshop／依賴">
           <Grid Margin="2">
            <Grid.RowDefinitions>
             <RowDefinition Height="Auto"/><RowDefinition Height="96"/>
             <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <StackPanel>
              <TextBlock Text="新增 Workshop ID（分號分隔）" Foreground="#E1A84B" FontWeight="Bold"/>
              <TextBlock Text="此欄只用來新增，成功解析後會自動清空。既有項目請到「伺服器模組」啟用、停用或移出。"
               Foreground="#AFC0C8" TextWrapping="Wrap" Margin="0,3,12,6"/>
             </StackPanel>
             <Border Grid.Column="1" Background="#10231D" BorderBrush="#297052" BorderThickness="1"
              CornerRadius="5" Padding="10,6" VerticalAlignment="Top">
               <TextBlock Text="目前伺服器清單不會因輸入欄空白而消失" Foreground="#72D3A2" FontWeight="Bold"/>
             </Border>
            </Grid>
            <TextBox x:Name="WorkshopBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"/>
            <Grid Grid.Row="2" Margin="0,8">
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <StackPanel Orientation="Horizontal">
               <Button x:Name="ResolveNewModsButton" Content="加入並解析" Click="ResolveNewMods_Click" Background="#8A641F"/>
               <Button x:Name="ResolveModsButton" Content="重新檢查全部" Click="ResolveMods_Click" Background="#297052"/>
               <Button Content="重新掃描已加入" Click="RefreshLocalMods_Click"/>
             </StackPanel>
             <TextBlock Grid.Column="1" x:Name="ResolvedModsText" Text="尚未解析" VerticalAlignment="Center"
              Foreground="#AFC0C8" Margin="12,0" TextTrimming="CharacterEllipsis"/>
             <ProgressBar Grid.Column="2" x:Name="ModResolveProgress" Width="130" Height="8"
              IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
            <Expander Grid.Row="3" Header="可選：檢查 Steam 頁面宣告的依賴候選" IsExpanded="False"
             Foreground="#E1A84B">
             <Grid Margin="0,6,0,0">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="WorkshopDependencyGrid" AutoGenerateColumns="False" CanUserAddRows="False"
               CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
               Background="#10171B" Foreground="White" RowBackground="#142027"
               AlternatingRowBackground="#19272E" BorderBrush="#3C515B" BorderThickness="1">
               <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="加入" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <DataGridTextColumn Header="Workshop ID" Binding="{Binding WorkshopId}" Width="115" IsReadOnly="True"/>
                <DataGridTextColumn Header="名稱" Binding="{Binding Title}" Width="1.4*" IsReadOnly="True"/>
                <DataGridTextColumn Header="由下列項目宣告" Binding="{Binding RequiredBy}" Width="1.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
               </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
               <TextBlock Text="Required Items 可能包含可選功能；請自行判斷。" Foreground="#AFC0C8"
                VerticalAlignment="Center" Margin="0,0,10,0"/>
               <Button Content="加入勾選候選（尚未下載／寫入）" Click="AddSelectedWorkshopDependencies_Click"
                Background="#8A641F"/>
              </StackPanel>
             </Grid>
            </Expander>
           </Grid>
          </TabItem>
           <TabItem Header="伺服器模組">
           <Grid Margin="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBox x:Name="ModSearchBox" ToolTip="搜尋 Workshop ID、Mod ID、名稱、分類、依賴或地圖"
              TextChanged="ModSearchBox_TextChanged"/>
             <ComboBox x:Name="ModFilterCombo" Grid.Column="1" Margin="4" SelectionChanged="ModFilterCombo_SelectionChanged">
              <ComboBoxItem Tag="All">全部項目</ComboBoxItem><ComboBoxItem Tag="Enabled">已啟用</ComboBoxItem>
              <ComboBoxItem Tag="Disabled">未啟用</ComboBoxItem><ComboBoxItem Tag="Warnings">需要確認</ComboBoxItem>
              <ComboBoxItem Tag="Maps">地圖</ComboBoxItem><ComboBoxItem Tag="Dependencies">框架／依賴</ComboBoxItem>
             </ComboBox>
             <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="勾選目前結果" Click="SelectVisibleMods_Click"/>
              <Button Content="取消目前結果" Click="ClearVisibleMods_Click"/>
             </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
             <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
             <DataGrid x:Name="ResolvedModsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#10171B"
              BorderBrush="#3C515B" BorderThickness="1" Foreground="White" RowBackground="#142027"
              AlternatingRowBackground="#19272E">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="啟用" Width="55">
                 <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding CanEnable}" HorizontalAlignment="Center" Click="ModEnabledCheck_Click"/>
                 </DataTemplate></DataGridTemplateColumn.CellTemplate>
